# Copy to .env.local and fill in. .env.local is not committed.

# Database: a local SQLite file for development, or a Turso database
# (DATABASE_URL=libsql://<db>.turso.io plus DATABASE_AUTH_TOKEN).
DATABASE_URL=file:data/rattlerevents.db
DATABASE_AUTH_TOKEN=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

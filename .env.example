# Database: a local SQLite file for development, or a Turso database
DATABASE_URL=file:data/rattlerradar.db
DATABASE_AUTH_TOKEN=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protects the daily sync route (/api/cron/sync). Set the same value in
# Vercel's environment variables. Generate with: openssl rand -base64 32
# CRON_SECRET=

# Jev (TypeSafe AI) tags events during syncs. Get a key at
# https://console.typesafe.ai/settings/keys and set it in Vercel too.
TYPESAFE_AI_API_KEY=
